package agent

import commons.io.filenameUtilsConcat
import std.application.workingDirectory
import commons.io.fileUtilsForceMkdir
import java.base.io.fileNew
import agent.internal.statementNew
import agent.internal.databaseNew
import std.annotation.Document
import std.filesystem.FileWriteMode
import std.filesystem.Path
import std.filesystem.openWrite
import std.io.TextEncoding
import std.io.encodeText
import std.io.writeAll
import std.json.JsonValue
import std.json.writeJson

@Document(description: "Receives ordered events for a conversation. The session identifier is generated by the library.")
public interface PersistProvider {
  @Document(description: "Appends one event.") Void append(@Document(description: "The conversation identifier.") String sessionId, @Document(description: "The event object.") JsonValue event)
}

@Document(description: "Appends UTF-8 JSON Lines to a generated file per session.")
public class JsonPersist implements PersistProvider {
  private String directory
  @Document(description: "Creates a JSON Lines provider.") JsonPersist(@Document(description: "Output directory, default session.") String directory = "session") {
    this.directory = filenameUtilsConcat(arg0: workingDirectory().value, arg1: directory)!!
  }

  @Document(description: "Appends and flushes one JSON event.")
  public Void append(@Document(description: "The conversation identifier.") String sessionId, @Document(description: "The event object.") JsonValue event) {
    fileUtilsForceMkdir(fileNew(directory))
    var writer = openWrite(path: Path(value: directory + "/" + sessionId + ".jsonl"), mode: FileWriteMode.Append)
    try { writeAll(writer: writer, content: encodeText(text: writeJson(value: event) + "\n", encoding: TextEncoding.Utf8)) }
    finally { writer.close() }
  }
}

@Document(description: "Records ordered events in a generated SQLite database per conversation.")
public class SqlitePersist implements PersistProvider {
  private String directory
  @Document(description: "Creates a SQLite provider.") SqlitePersist(@Document(description: "Output directory, default session.") String directory = "session") {
    this.directory = filenameUtilsConcat(arg0: workingDirectory().value, arg1: directory)!!
  }

  @Document(description: "Commits one event in SQLite.")
  public Void append(@Document(description: "The conversation identifier.") String sessionId, @Document(description: "The event object.") JsonValue event) {
    fileUtilsForceMkdir(fileNew(directory))
    var database = databaseNew()!!
    database.setUrl("jdbc:sqlite:" + directory + "/" + sessionId + ".sqlite")
    var connection = database.getConnection(arg0: "", arg1: "")!!
    try {
      var schema = statementNew(arg0: connection, arg1: "CREATE TABLE IF NOT EXISTS events (sequence INTEGER PRIMARY KEY, event TEXT NOT NULL)")!!
      try { schema.executeUpdate() } finally { schema.close() }
      var insert = statementNew(arg0: connection, arg1: "INSERT INTO events(event) VALUES (?)")!!
      try {
        insert.setString(arg0: 1, arg1: writeJson(value: event))
        insert.executeUpdate()
      } finally { insert.close() }
    } finally { connection.close() }
  }
}
